{
  "manifest_version": 3,
  "name": "Kantbotha",
  "version": "1.3.0",
  "description": "Quality of life improvements for the Kantata/Mavenlink experience, plus a Kantata to Workday timesheet copier.",
  "homepage_url": "https://github.com/Mjone77/kantbotha",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "96": "icons/icon_96.png",
    "128": "icons/icon_128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kantbotha@mloney.com"
    }
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Kantbotha: copy Kantata time to Workday"
  },
  "options_ui": {
    "page": "timesheet/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mavenlink.com/workspaces/*"
      ],
      "exclude_matches": [
        "https://*.mavenlink.com/workspaces/*/gantt"
      ],
      "css": ["content_scripts/kantbotha.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.mavenlink.com/workspaces/*"
      ],
      "exclude_matches": [
        "https://*.mavenlink.com/workspaces/*/gantt"
      ],
      "js": ["content_scripts/kantbotha.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://*.mavenlink.com/*",
    "https://wd5.myworkday.com/*"
  ]
}